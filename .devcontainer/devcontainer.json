{
  "name": "Triage AI Pipeline",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  // Install these VS Code extensions automatically for everyone on the team
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // CRITICAL NETWORKING: Tell the Python container how to find the Ollama engine running on the host laptop.
  // 'host.docker.internal' is the magic word that routes traffic out of Docker and into your Mac/Windows host.
  "remoteEnv": {
    "OLLAMA_HOST": "http://host.docker.internal:11434"
  },
  
  // Ensure the container has the right permissions to run the file system
  "remoteUser": "root"
}